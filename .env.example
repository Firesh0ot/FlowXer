FLOWXER_HOST=0.0.0.0
FLOWXER_PORT=9610
FLOWXER_MXL_DOMAIN=/mxl-domain
FLOWXER_STORAGE_ROOT=/storage
FLOWXER_GROUP_HINT=FlowXer
FLOWXER_WIDTH=1920
FLOWXER_HEIGHT=1080
FLOWXER_FRAME_RATE_NUM=50
FLOWXER_FRAME_RATE_DEN=1
FLOWXER_AUDIO_RATE=48000
FLOWXER_AUDIO_CHANNELS=2
FLOWXER_VIDEO_MEDIA_TYPE=video/v210
FLOWXER_AUDIO_MEDIA_TYPE=audio/float32
FLOWXER_GST_MODE=auto
FLOWXER_OVERLAY_URL=http://127.0.0.1:9610/graphics/lower-third.html
# Required on public / staging networks (8-128 chars in [A-Za-z0-9._~-]).
# Leave empty only for local development.
FLOWXER_API_TOKEN=
# Comma-separated browser origins. "*" is fine when the GUI nginx-proxies /api.
FLOWXER_CORS_ORIGINS=*
FLOWXER_MAX_WEBRTC_PEERS=16
