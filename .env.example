FLOWXER_HOST=127.0.0.1
FLOWXER_PORT=9610
# Bridge Compose must override FLOWXER_HOST=0.0.0.0 so the GUI container can reach the mixer.
# Preferred: scan this root for domain_def.json (identity is the JSON id).
FLOWXER_MXL_ROOT=/Volumes/mxl
# Optional. Default is <root>/flowxer-<seed-short>. Created on start if missing.
# FLOWXER_MXL_OUTPUT_DOMAIN_DIR=/Volumes/mxl/flowxer-studio
# FLOWXER_MXL_OUTPUT_DOMAIN_ID=
# FLOWXER_MXL_REVISION=218ddaa0a08c12ffe75fc475ae65aa3d9eef16d7
# FLOWXER_NMOS_SEED=
# IS-04/IS-05 node (BCP-007-03). Separate port, not behind FLOWXER_API_TOKEN.
FLOWXER_NMOS_ENABLE=true
FLOWXER_NMOS_DNS_SD=false
FLOWXER_NMOS_PORT=3252
# FLOWXER_NMOS_HOST_IP=
# FLOWXER_NMOS_REGISTRY_URL=http://10.0.0.5:3210
# Platform names (win over the FLOWXER_ names): MXL_DOMAIN_SCAN_PATH, MXL_OUTPUT_DOMAIN_DIR,
# MXL_OUTPUT_DOMAIN_ID, MXL_HISTORY_DURATION, NMOS_SEED, NMOS_PORT, NMOS_HOST_ADDRESS.
# NMOS_REGISTRY_ADDRESS=10.0.0.5
# NMOS_REGISTRY_PORT=3210
# NMOS_LABEL=FlowXer 1
# NMOS_TAGS={"urn:x-srf:production":["demo"]}
# Remove the own output domain on SIGTERM.
# MXL_CLEANUP_ON_EXIT=false
# Saved mixer state (state.json); mount it to keep the state across restarts.
# FLOWXER_STATE_DIR=/config
# SHUTDOWN_TIMEOUT_S=10
# Deprecated single-domain alias (sets root and output to this path).
# FLOWXER_MXL_DOMAIN=/mxl-domain
FLOWXER_STORAGE_ROOT=/storage
FLOWXER_GROUP_HINT=FlowXer
FLOWXER_WIDTH=1920
FLOWXER_HEIGHT=1080
FLOWXER_FRAME_RATE_NUM=50
FLOWXER_FRAME_RATE_DEN=1
FLOWXER_AUDIO_RATE=48000
FLOWXER_AUDIO_CHANNELS=2
FLOWXER_VIDEO_MEDIA_TYPE=video/v210
FLOWXER_AUDIO_MEDIA_TYPE=audio/float32
FLOWXER_GST_MODE=auto
FLOWXER_OVERLAY_URL=http://127.0.0.1:9610/graphics/lower-third.html
# Required on public / staging networks (8-128 chars in [A-Za-z0-9._~-]).
# Leave empty only for local development.
FLOWXER_API_TOKEN=
# Comma-separated browser origins. "*" is fine when the GUI nginx-proxies /api.
FLOWXER_CORS_ORIGINS=*
FLOWXER_MAX_WEBRTC_PEERS=16
# FLOWXER_WEBRTC_PUBLIC_IP=10.0.0.20
# FLOWXER_WEBRTC_UDP_PORT_MIN=32600
# FLOWXER_WEBRTC_UDP_PORT_MAX=32631
# GUI nginx / Vite upstream (hostNetwork: http://127.0.0.1:9610).
# FLOWXER_MIXER_URL=http://127.0.0.1:9610
# FLOWXER_GUI_PORT=9620
# GHCR tag published from main (latest, or a version such as 5.9.15).
FLOWXER_IMAGE_TAG=latest
